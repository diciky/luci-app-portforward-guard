config portforward 'config'
	option enabled '1'
	option auto_block '1'
	option auto_block_login '1'
	option refresh_interval '5'
	option geo_lookup_cache '3600'
	option log_level 'info'

config blacklist 'blacklist'
	option default_duration '3600'
	list temp_ban_times '300,900,3600,86400'
	option permanent_default '0'

config whitelist 'whitelist'
	option enabled '1'
	option strict_mode '1'
	option auto_add_failed_login '1'

config ipset 'ipset'
	option blacklist_name 'portforward_blacklist'
	option whitelist_name 'portforward_whitelist'
	option persist '1'

config geoip 'geoip'
	option provider 'ip-api.com'
	option cache_ttl '86400'

config logging 'logging'
	option log_connections '1'
	option log_blocks '1'
	option log_auto_blocks '1'
	option max_log_size '10000'
